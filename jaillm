#!/usr/bin/env bash
#
# A script to run a jailed language model in Nix (or Docker).
#
# Usage:
#
# $ ./jaillm [-f|--file <path>] [run|init]

set -eou pipefail

# Default values
filepath="jaillm.nix"
command="run"
# Command to run inside the jail instead of the configured entrypoint.
# Populated by any arguments following the `run` command.
cmd_args=()

# Show usage information
usage() {
    echo "Usage: jaillm [-f|--file <path>] [run [-- <cmd>...] | init]"
    echo ""
    echo "Commands:"
    echo "  run [<cmd>...]   Run the jailed LLM (default). Any arguments after"
    echo "                   'run' override the configured entrypoint, e.g."
    echo "                   'jaillm run bash' opens a shell inside the jail."
    echo "  init             Create a jaillm.nix file"
    echo ""
    echo "Options:"
    echo "  -f, --file <path>  Path to jaillm.nix file (default: jaillm.nix)"
    echo "  -h, --help         Show this help message"
}

# Run command
cmd_run() {
    # If not a file, fail
    if [ ! -f "$filepath" ]; then
        echo "Error: File '$filepath' not found."
        exit 1
    fi

    export NIXPKGS_FLAKE=${NIXPKGS_FLAKE:-"github:NixOS/nixpkgs/nixpkgs-unstable"}
    export JAILLM_FLAKE=${JAILLM_FLAKE:-"github:myme/jaillm"}
    export JAILLM_NIX="$(readlink -f "$filepath")"

    # Arguments after `run` override the configured entrypoint. Quote them into
    # a single command string that's safe to re-evaluate inside the jail.
    if [ ${#cmd_args[@]} -gt 0 ]; then
        export JAILLM_CMD="$(printf '%q ' "${cmd_args[@]}")"
    fi

    nix run --impure --expr '
let
  nixpkgs = builtins.getFlake (builtins.getEnv "NIXPKGS_FLAKE");
  jaillm = builtins.getFlake (builtins.getEnv "JAILLM_FLAKE");
  config = import (builtins.getEnv "JAILLM_NIX");
in
  jaillm.lib.build (import nixpkgs) (pkgs:
    let
      cfg = config pkgs;
      cmd = builtins.getEnv "JAILLM_CMD";
    in
    # Override the configured entrypoint with the command passed to `run`.
    cfg // (if cmd != "" then {
      entry = pkgs.writeShellScriptBin "jaillm-entry" "exec ${cmd}";
    } else { }))
'
}

# Init command
cmd_init() {
    if [ -f "$filepath" ]; then
        echo "Error: File '$filepath' already exists."
        exit 1
    fi

    cat > "$filepath" << 'EOF'
pkgs:
{
  entry = pkgs.bashInteractive;
  llms = [ pkgs.claude-code pkgs.gemini-cli ];
  # Share host $HOME paths into the jail (e.g. for auth)
  shareHomePaths = [ ".claude" ];
  extraUtils = [
    pkgs.curl
  ];
}
EOF

    echo "Created '$filepath'"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--file)
            filepath="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        run)
            command="run"
            shift
            # Everything after `run` is the command to run inside the jail,
            # overriding the configured entrypoint.
            cmd_args=("$@")
            break
            ;;
        init)
            command="init"
            shift
            ;;
        *)
            echo "Error: Unknown option or command '$1'"
            usage
            exit 1
            ;;
    esac
done

# Execute the command
case $command in
    run)
        cmd_run
        ;;
    init)
        cmd_init
        ;;
esac
